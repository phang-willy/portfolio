SERVER_PORT=3000
APP_TITLE=Test
# Origines autorisées pour les ressources Next dev (HMR, overlay).
# Ajoute ton IP LAN si tu ouvres le front depuis un autre appareil.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.1.2

#
# Optionnel : URL RAW du JSON des projets sur la branche content.
# Exemple:
# PROJECTS_JSON_URL=https://raw.githubusercontent.com/<github-username>/<repo-name>/content/data/project.json
PROJECTS_JSON_URL=

# Production : URL de base (sans slash final) de l’API /api/contact* si elle n’est pas sur le même hôte que le site. En dev (next dev), ignoré : les routes /api du même serveur Next sont utilisées.
# NEXT_PUBLIC_CONTACT_API_ORIGIN=

# Messages d'erreur du formulaire contact : false = message générique visiteur ; true = détails + réponses brutes Brevo (HTTP, code, message, corps)
CONTACT_ERROR=false

# Sécurité formulaire contact : origines autorisées pour POST (séparées par des virgules), ex. https://mondomaine.fr - vide = pas de filtre
CONTACT_ALLOWED_ORIGINS=
# Limites par IP (mémoire serveur, par instance) : max requêtes par fenêtre (ms)
CONTACT_RATE_LIMIT_POST_MAX=12
CONTACT_RATE_LIMIT_POST_WINDOW_MS=900000
CONTACT_RATE_LIMIT_STATUS_MAX=120
CONTACT_RATE_LIMIT_STATUS_WINDOW_MS=60000

GITHUB_USERNAME=github-username
GITHUB_TOKEN=github-token

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Adresse e-mail destinataire principale pour le formulaire de contact
CONTACT_TO_EMAIL=
# Templates Brevo : confirmation envoyée au visiteur (mêmes params : FIRSTNAME, LASTNAME, EMAIL, etc.)
# FR : /contact - requis. Ancien nom encore accepté : BREVO_CONTACT_USER_TEMPLATE_ID.
BREVO_CONTACT_FR_USER_TEMPLATE_ID=
# EN : /en/contact - optionnel ; si vide, le template FR est utilisé.
BREVO_CONTACT_EN_USER_TEMPLATE_ID=
# Optionnel : template Brevo pour CONTACT_TO_EMAIL (toi), mêmes params ; si vide, email HTML généré par l'app
BREVO_CONTACT_ADMIN_TEMPLATE_ID=
# Optionnel : second template Brevo (ex. copie perso) vers CONTACT_FALLBACK_EMAIL, mêmes params ; exige CONTACT_FALLBACK_EMAIL
BREVO_CONTACT_FALLBACK_TEMPLATE_ID=

# Alerte quota : email de secours (HTML) si crédits sendLimit < CONTACT_MIN_BREVO_CREDITS
CONTACT_FALLBACK_EMAIL=
# Crédits minimum par envoi : 2 sans copie fallback template, 3 si BREVO_CONTACT_FALLBACK_TEMPLATE_ID est défini
CONTACT_MIN_BREVO_CREDITS=2
# Délai minimum entre deux alertes fallback (ms), évite un spam à chaque chargement de page
CONTACT_FALLBACK_ALERT_COOLDOWN_MS=21600000

BREVO_SMTP_KEY=
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_LOGIN=

SITE_URL=http://localhost:3000

NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Clé CARTO basemaps (carte About). Gratuite : https://carto.com/basemaps/apikey/
CARTO_API_KEY=

#
# Docker / services
# Choisis un seul profile Docker Compose, puis lance `docker compose up -d --build`.
COMPOSE_PROFILES=dev
# COMPOSE_PROFILES=prod
FRONT_BIND_ADDRESS=127.0.0.1
FRONT_PORT=3000
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=3001
BACK_BIND_ADDRESS=127.0.0.1
BACK_PORT=8000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
ADMINER_BIND_ADDRESS=127.0.0.1
ADMINER_PORT=8080
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=1080

#
# Backend Spring Boot / PostgreSQL
REGISTER_ENABLE=false
APP_PUBLIC_BASE_URL=http://localhost:8000
APP_ADMIN_BASE_URL=http://localhost:3001
APP_AUTH_JWT_SECRET=change-this-dev-jwt-secret-with-at-least-32-characters
APP_AUTH_TOKEN_HASH_SECRET=change-this-dev-token-hash-secret-with-at-least-32-characters
APP_AUTH_COOKIE_NAME=access_token
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAME_SITE=None
APP_AUTH_COOKIE_PATH=/api
APP_EMAIL_QUEUE_SCHEDULER_DELAY_MILLIS=60000
APP_EMAIL_QUEUE_RETRY_DELAY=5m
APP_EMAIL_QUEUE_BATCH_SIZE=10
APP_EMAIL_QUEUE_MAX_ATTEMPTS=3
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_FROM=noreply@phangwilly.local
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/portfolio
SPRING_DATASOURCE_USERNAME=portfolio
SPRING_DATASOURCE_PASSWORD=portfolio_change_me
SPRING_DATASOURCE_MAX_POOL_SIZE=10
SPRING_DATASOURCE_MIN_IDLE=2
SPRING_DATASOURCE_CONNECTION_TIMEOUT_MS=30000

#
# PostgreSQL container
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_change_me
