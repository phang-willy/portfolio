{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"],
      "cwd": "admin"
    },
    "spartan-ng": {
      "command": "npx",
      "args": ["-y", "spartan-ng-mcp"],
      "cwd": "admin",
      "env": {
        "DOTENV_CONFIG_PATH": "../.env"
      }
    }
  }
}
